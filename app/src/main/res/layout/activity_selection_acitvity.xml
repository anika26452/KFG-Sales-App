<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:gravity="center"
    android:background="@color/white"
    tools:context="com.sysnova.kfg_sales_appv903.Activity.SelectionAcitvity">

    <TextView
        android:layout_marginTop="2dp"
        android:layout_width="wrap_content"
        android:id="@+id/username"
        android:layout_gravity="center"
        android:text="User Name"
        android:textColor="@color/brac_blue"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_height="wrap_content"></TextView>

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/DBsync_button"
        android:layout_marginTop="25dp"
        android:onClick="DBsyncActivity"
        android:padding="15dp"
        android:backgroundTint="@color/brac_blue"
        android:text="DB Sync"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        />

    <Button
        android:id="@+id/createorder"
        android:layout_marginTop="30dp"
        android:text="Create order"
        android:padding="15dp"
        android:backgroundTint="@color/green"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:onClick="OrderActivity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    </Button>

    <Button
        android:id="@+id/vieworder"
        android:padding="15dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/green"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:onClick="DBsyncView"
        android:text="View Order"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    </Button>

    <Button
        android:id="@+id/OrderSendToERP"
        android:padding="15dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/green"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:onClick="OrderSendToERP"
        android:text="Order Send To ERP"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    </Button>

    <Button
        android:id="@+id/createpayment"
        android:layout_marginTop="30dp"
        android:text="Create payment"
        android:padding="15dp"
        android:backgroundTint="@color/bluegrey"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:onClick="createpaymentactivity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    </Button>

    <Button
        android:id="@+id/viewpayment"
        android:padding="15dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/bluegrey"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:onClick="viewpaymentactivity"
        android:text="View payment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    </Button>

    <Button
        android:id="@+id/OrderCancel"
        android:padding="15dp"
        android:layout_marginTop="30dp"
        android:backgroundTint="@color/redish"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:onClick="callCancelLogOut"
        android:text="LogOut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    </Button>

</LinearLayout>